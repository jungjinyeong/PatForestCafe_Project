  m_text: "\uAD7D\uAE30\uB97C \uC2DC\uC791\uD558\uBA74 \uC124\uC815\uD55C \uBAA8\uB4E0
    \uD2B8\uB808\uC774\uC758 \uC7AC\uB8CC\uB97C \uD569\uC0B0\uD574 \uD55C \uBC88\uC5D0
    \uCC28\uAC10\uD574\uC694. \uAD7D\uAE30\uAC00 \uB05D\uB098\uBA74 \uC644\uC131\uD55C
    \uBE75\uC744 \uCC3D\uACE0(\uBE75 \uC7AC\uACE0)\uB85C \uC790\uB3D9\uC73C\uB85C
    \uC62E\uACA8 \uBCF4\uAD00\uD558\uACE0, \uC9C4\uC5F4\uB300\uC5D0\uB294 \uB192\uC740
    \uD488\uC9C8\uBD80\uD130 \uC62C\uB77C\uAC00\uC694."
